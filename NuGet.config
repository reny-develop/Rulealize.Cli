<?xml version="1.0" encoding="utf-8"?>
<!--
  A folder feed beside the repositories, produced by `dotnet pack`. There is no <clear/>
  here, so this is added to nuget.org rather than replacing it: a package that has been
  published restores from nuget.org, and one that has not — or one being changed locally —
  restores from here.

  Everything this tool needs is published, so the feed is only reached for a change to
  Rulealize being tried out before it is.
-->
<configuration>
  <packageSources>
    <add key="rulealize-local" value="..\LocalNuGet" />
  </packageSources>
</configuration>
