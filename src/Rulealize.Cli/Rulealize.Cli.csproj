<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);NU1605</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rulealize</ToolCommandName>
    <PackageId>Rulealize.Cli</PackageId>
    <Version>0.6.0</Version>
    <Authors>Reny</Authors>
    <Description>Runs a Rulealize rule set from a command line: restore the plugins it requires, report what a plugin folder provides, and check, list the legal inputs, apply one, or walk it interactively — a rule set that holds other rule sets included.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/reny-develop/Rulealize.Cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The runtime, and every command here is a caller of it: restore and check compile a
    document, moves asks what is legal, apply and play transition a state and ask what could
    happen to it.

    PluginRequirement and PluginResolution come from the same package on purpose. Both are
    pure and both could have been written here, and the reason they were not is that a
    second reading of ^1.0 would eventually differ from the runtime's, and the way it would
    show is this tool assembling a folder the runtime then refuses. RuleSetRequirement is
    there for the same reason a version further on: what a document holds is read off the
    document by the runtime's own reader, so the set gathered here is the set it compiles.
  -->
  <ItemGroup>
    <PackageReference Include="Rulealize" Version="0.6.0" />
  </ItemGroup>

</Project>
